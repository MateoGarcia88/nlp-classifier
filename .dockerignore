# Keep the build context small and the image clean.

# Generated artifacts (regenerated inside the container by the pipeline scripts).
data/
results/
figures/

# Python / env cruft
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Caches (the HF model cache is persisted via a Docker volume, not the image)
.cache/
hf_cache/
.gradio/
flagged/

# VCS / IDE / OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs not needed at runtime
*.md
